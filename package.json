{
  "name": "account-demolisher",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade Stellar account-closure tool with classic + Soroban + DeFi support.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "mediator:legacy-forward": "node scripts/mediator-legacy-forward.mjs"
  },
  "dependencies": {
    "@blend-capital/blend-sdk": "3.3.1",
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@stellar/stellar-sdk": "17.2.1",
    "@xstate/react": "6.1.0",
    "buffer": "^6.0.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "xstate": "5.33.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "@walletconnect/sign-client": "2.26.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "lefthook": "2.2.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
