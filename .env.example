# Stellar network selection: "mainnet" | "testnet" | "futurenet"
# Horizon / Soroban RPC endpoints are pinned per network (not overridable here).
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployment mode: "reference" runs the exchange mediator (server-derived,
# per-flow ephemeral keys derived from MEDIATOR_SECRET), which enables closes to
# memo-required exchanges. "self-hosted" does NOT run the mediator: mediator/CEX
# closes are blocked in the UI, leaving only direct (non-exchange) merges.
NEXT_PUBLIC_DEPLOYMENT_MODE=reference

# Slippage tolerance (basis points) applied to EVERY market conversion in a close
# — the classic path-payment / LP-withdraw floors AND the Soroban DeFi-exit and
# token-swap floors, one shared policy. Integer in [10, 500]; default 100 (1%).
# An out-of-range or malformed value falls back to the default.
# NEXT_PUBLIC_SLIPPAGE_BPS=100

# --- SERVER-ONLY VARIABLES (never expose to the client) ---

# Mediator account secret (S...). Required only when deployment mode is "reference".
# Generate per-deployment; never share. Keypair derives the mediator public key.
MEDIATOR_SECRET=

# CORS allow-list for the mediator co-signing endpoint (/api/mediator/sign).
# Comma-separated origins. Unset means no cross-origin CORS headers are emitted
# (same-origin only), which is the safe default.
MEDIATOR_ALLOWED_ORIGIN=

# Number of trusted reverse-proxy hops in front of the app, used to derive the
# real client IP for rate limiting from X-Forwarded-For. Set to the count of
# proxies you control (0 when the app is directly exposed). Defaults to 1.
TRUSTED_PROXY_HOPS=1

# Soroswap routing API. Server-proxied to conceal the key from the client.
# Used only for converting non-XLM balances to XLM via the aggregator.
SOROSWAP_API_URL=https://api.soroswap.finance
SOROSWAP_API_KEY=
