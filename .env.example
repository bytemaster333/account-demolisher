# Copy to .env.local for local development. Docker Compose reads the same names
# from a .env file next to docker-compose.yml. Every variable is documented at
# docs/content/docs/developers/reference/configuration.mdx.

# --- PUBLIC VARIABLES (inlined into the client bundle at build time) ---
# A change needs a rebuild. In Docker they are build arguments. A blank value
# counts as unset.

# Starting network: "mainnet" | "testnet". The header switches between them at
# runtime. Horizon and Soroban RPC endpoints are pinned per network in
# src/lib/config/networks.ts and are not set here.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# "reference" runs the exchange mediator, so closes can reach destinations that
# need a memo (a registry exchange, or an account with the SEP-29 memo flag).
# "self-hosted" does not run it: those closes are refused, and direct closes
# work as usual. docker-compose.yml defaults to self-hosted.
NEXT_PUBLIC_DEPLOYMENT_MODE=reference

# WalletConnect (Reown) project id, a public client-side identifier from
# https://cloud.reown.com. When set, WalletConnect joins the wallet picker. When
# unset it is left out and its relay is never contacted.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical public origin for page metadata, the sitemap and robots.txt.
# Defaults to https://demolisher.app; set your own origin when you self-host.
NEXT_PUBLIC_SITE_URL=https://demolisher.app

# Slippage tolerance in basis points for every market conversion in a close:
# the classic path-payment and pool-withdraw floors and the Soroban exit and
# swap floors. A whole number from 10 to 500; default 100 (1%). Unset or blank
# uses the default; any other invalid value fails the build and `next dev`.
# NEXT_PUBLIC_SLIPPAGE_BPS=100

# Floor in stroops for a conversion's XLM output. A balance whose
# slippage-adjusted output is at or below it is not sold, and goes to its
# issuer or to the destination instead. Default 0 refuses only a sale that nets
# nothing. A whole number, 0 or more; anything else fails the build.
# NEXT_PUBLIC_MIN_MARKET_OUT_STROOPS=0

# --- SERVER-ONLY VARIABLES (read at runtime, never sent to the client) ---

# HMAC master seed (S..., 56 characters) for the per-close mediator keys and the
# flow tokens. It is not an account and never signs a transaction: do not fund
# it. Whoever holds it can derive every mediator key, so keep it secret and use
# one per deployment. Needed only when NEXT_PUBLIC_DEPLOYMENT_MODE=reference.
MEDIATOR_SECRET=

# Comma-separated origins allowed to call the mediator routes
# (/api/mediator/sign, /api/mediator/reissue) cross-origin. Unset means
# same-origin only.
MEDIATOR_ALLOWED_ORIGIN=

# Reverse proxies in front of the app that append to X-Forwarded-For; the rate
# limiter keys on the entry this many places from the right. The app is
# supported only behind a reverse proxy, so this is a whole number of at least
# 1: 1 for the Caddy proxy docker-compose.yml ships, more when a CDN or another
# proxy sits in front of it. The server refuses to start on 0 or a non-integer.
# Unset means 1.
TRUSTED_PROXY_HOPS=1

# Bearer token for reading the aggregate metrics (GET /api/metrics), at least 16
# characters. Unset or shorter makes that read answer 503. Recording metrics
# (POST) does not need it. Generate a long random value.
METRICS_ADMIN_TOKEN=

# Writable directory for the metrics store (closes.jsonl and counters.json) and
# the mediator's co-sign log (cosign.jsonl).
# Unset means data/ under the working directory. docker-compose.yml fixes it to
# /app/data on the metrics volume.
METRICS_DB_DIR=
